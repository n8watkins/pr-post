{
  // The owner's private paper, The Pull Request Post, on Cloudflare Workers.
  // Nothing private is in this file or this repository: the watch list,
  // profiles and settings live in the D1 database and every file (collected
  // data, reports, the built site) in the R2 bucket, read and written only
  // through this Worker (worker/store.js, docs/private-mode.md).
  //
  // Deploy from the repository root:
  //   npx wrangler@4.151.3 deploy -c paper/wrangler.jsonc               # the live paper
  //   npx wrangler@4.151.3 deploy -c paper/wrangler.jsonc --env staging # pull-request-post-next
  //   npx wrangler@4.151.3 d1 migrations apply pr-post -c paper/wrangler.jsonc --remote
  // Secrets (set with `wrangler secret put`, never here): SITE_PASSWORD,
  // JOBS_TOKEN, WRITER_TOKEN, ACTION_SIGNING_KEY, ACTIONS_TOKEN, ALLOWED_EMAILS.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pull-request-post",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "../worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "SITE_TITLE": "The Pull Request Post", // the name the password prompt shows
    "SITE_PREFIX": "site/",
    "GITHUB_REPO": "n8watkins/pr-post",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // The SNS topic SES reports bounces and complaints to (the TopicArn output of paper/aws/ses.yml).
    "SES_TOPIC_ARN": ""
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pr-post", "database_id": "2b4ca910-88b0-494b-a51d-a0c6da9a8869", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "STORE", "bucket_name": "pr-post-paper" }],
  "observability": { "enabled": true },
  "env": {
    // A second Worker on the same storage that serves the site from site-next/,
    // for checking a change end to end before the live paper gets it.
    "staging": {
      "name": "pull-request-post-next",
      "workers_dev": true,
      "vars": {
        "SITE_TITLE": "The Pull Request Post (staging)",
        "SITE_PREFIX": "site-next/",
        "GITHUB_REPO": "n8watkins/pr-post",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "SES_TOPIC_ARN": ""
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "pr-post", "database_id": "2b4ca910-88b0-494b-a51d-a0c6da9a8869", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "STORE", "bucket_name": "pr-post-paper" }],
      "observability": { "enabled": true }
    }
  }
}
