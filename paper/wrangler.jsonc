{
  // The owner's private paper, The Pull Request Post, on Cloudflare Workers.
  // Nothing private is in this file or this repository: the watch list,
  // profiles and settings live in the D1 database and every file (collected
  // data, reports, the built site) in the R2 bucket, read and written only
  // through this Worker (worker/store.js, docs/private-mode.md).
  //
  // Deploy from the repository root:
  //   npx wrangler@4.151.3 deploy -c paper/wrangler.jsonc               # the live paper
  //   npx wrangler@4.151.3 d1 migrations apply pr-post -c paper/wrangler.jsonc --remote
  // Secrets (set with `wrangler secret put`, never here): SITE_PASSWORD (only
  // until Cloudflare Access is on), JOBS_TOKEN, WRITER_TOKEN, ACTION_SIGNING_KEY, ACTIONS_TOKEN, ALLOWED_EMAILS.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pull-request-post",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  // worker/main.js adds the EmailEvents entrypoint (bounces from mailroom) to worker/index.js.
  "main": "../worker/main.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "SITE_TITLE": "The Pull Request Post", // the name the password prompt shows
    "SITE_PREFIX": "site/",
    "GITHUB_REPO": "n8watkins/pr-post",
    // Cloudflare Access (Zero Trust team white-poetry-96ec): the Worker verifies
    // every sign-in against this team and the app's audience tag. Neither is secret.
    "ACCESS_TEAM_DOMAIN": "white-poetry-96ec.cloudflareaccess.com",
    "ACCESS_AUD": "78b00f8da1aabd80cccb906f1452687068f4d9b3df0d210cdadf61f2754f5625", // gitleaks:allow (public: sent in every Access login redirect)
    // The sender's display name on the paper's emails (worker/email.js).
    "EMAIL_FROM_NAME": "The Pull Request Post"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pr-post", "database_id": "2b4ca910-88b0-494b-a51d-a0c6da9a8869", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "STORE", "bucket_name": "pr-post-paper" }],
  // The paper's email goes through mailroom (github.com/n8watkins/mailroom),
  // which sends from prpost@n8builds.dev with caps and passes bounces back to
  // the EmailEvents entrypoint (on this Worker, which mailroom's HOOK_PRPOST names).
  "services": [{ "binding": "MAILROOM", "service": "mailroom", "entrypoint": "Mailroom", "props": { "app": "prpost" } }],
  "observability": { "enabled": true },
  // The clock for the paper's GitHub Actions jobs (worker/jobs.js): collect on
  // Wednesdays and Saturdays at 11:00 UTC, the Gemini writer at 16:45 once the
  // Claude routine's 16:00 run is in, and publish (plus the Gemini writer, if
  // 16:45 did not start it) as a backstop at 17:30 and 20:30.
  // Add "0 10 * * 6" to start Who to follow on Saturdays.
  "triggers": { "crons": ["0 11 * * 3,6", "45 16 * * 3,6", "30 17,20 * * 3,6"] }
}
